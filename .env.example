# 复制该文件为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）
# 环境变量前缀统一为 RAG_，嵌套用双下划线 __

# ---------------- 基础 ----------------
RAG_ENV=development
RAG_LOG_LEVEL=INFO

# ---------------- 向量库 ----------------
# 本地 docker compose 起来的 Milvus Standalone
RAG_MILVUS__URI=http://127.0.0.1:19530
RAG_MILVUS__COLLECTION=rag_enterprise
RAG_MILVUS__USER=
RAG_MILVUS__PASSWORD=
RAG_MILVUS__DATABASE=default
# 稠密向量维度，必须与所选 embedding 模型输出一致
RAG_MILVUS__DENSE_DIM=1024
RAG_MILVUS__TOP_K=5
RAG_MILVUS__RRF_K=60

# ---------------- Embedding ----------------
# hashing = 离线确定性向量（仅用于打通链路/跑 CI，没有语义能力）
# openai  = 调用 OpenAI 兼容接口（DeepSeek / 智谱 / 通义 / OpenAI）
RAG_EMBEDDING__PROVIDER=hashing
RAG_EMBEDDING__MODEL=text-embedding-3-small
RAG_EMBEDDING__BASE_URL=
RAG_EMBEDDING__API_KEY=
RAG_EMBEDDING__BATCH_SIZE=32

# ---------------- 大模型 ----------------
RAG_LLM__BASE_URL=https://api.deepseek.com
RAG_LLM__API_KEY=
RAG_LLM__MODEL=deepseek-chat
RAG_LLM__TEMPERATURE=0.0
RAG_LLM__MAX_TOKENS=2048
RAG_LLM__TIMEOUT=60

# ---------------- 入库 ----------------
RAG_INGEST__DATA_DIR=data/raw
RAG_INGEST__CHUNK_SIZE=800
RAG_INGEST__CHUNK_OVERLAP=120
RAG_INGEST__MIN_CHUNK_CHARS=30
RAG_INGEST__BATCH_SIZE=64

# ---------------- 检索 ----------------
RAG_RETRIEVAL__TOP_K=5
RAG_RETRIEVAL__CANDIDATE_MULTIPLIER=4
RAG_RETRIEVAL__SCORE_THRESHOLD=0.0
RAG_RETRIEVAL__ENABLE_RERANK=false

# ---------------- 图（自我纠正控制） ----------------
RAG_GRAPH__MAX_REWRITE=2
RAG_GRAPH__MAX_GENERATE_RETRY=1
RAG_GRAPH__ENABLE_ROUTE=true
RAG_GRAPH__MIN_GROUNDED_SCORE=0.3

# ---------------- Wiki 增强层（可选，默认关闭） ----------------
# 开启后：路由 → wiki 直答（命中就不检索、不生成）→ 未命中回原链路
RAG_WIKI__ENABLED=false
RAG_WIKI__ROOT=
RAG_WIKI__HIT_THRESHOLD=0.6
RAG_WIKI__MIN_COVERAGE=0.2
RAG_WIKI__STALE_DAYS=90
RAG_WIKI__WRITEBACK_ENABLED=false
RAG_WIKI__WRITEBACK_SCORE=0.7

# ---------------- 服务 ----------------
RAG_API__HOST=127.0.0.1
RAG_API__PORT=8099
# 留空 = 不鉴权（仅本地）；生产一定要设，并在网关层再加一道
RAG_API__API_KEY=
RAG_API__CORS_ORIGINS=*
